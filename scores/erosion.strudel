// Subtractive synthesis: a rich saw wave loses upper harmonics as the reading descends.
// G Dorian, grounded by G and D. Reverse reading reveals the brighter layers again.
stack(
  arrange(
    [4, note("g3 d4 f4 a4 g4 f4 d4 c4 bb3 d4 f4 g4 a4 g4 f4 d4").slow(4).lpf(5200)],
    [4, note("d4 f4 g4 a4 bb4 a4 g4 f4 e4 d4 c4 d4 f4 e4 d4 g3").slow(4).lpf(1900)],
    [4, note("g3 bb3 d4 f4 e4 d4 c4 bb3 a3 g3 d4 c4 bb3 a3 d4 g3").slow(4).lpf(650)]
  ).s("sawtooth").gain(0.16).attack(0.04).decay(0.15).sustain(0.4).release(0.2),
  note("g2 d3 g2 d3").slow(4).s("triangle").gain(0.09).lpf(550).release(0.2)
)
