// FM synthesis: non-integer carrier/modulator ratios evoke metal's complex resonance.
// E minor pentatonic. This is an original interpretation, not the Liberty Bell's actual tone.
stack(
  arrange(
    [4, note("e4 b4 d5 e5 d5 b4 a4 g4 e4 g4 a4 b4 d5 b4 g4 e4").slow(4).fm(0.22)],
    [4, note("g4 b4 d5 e5 g5 e5 d5 b4 a4 b4 d5 e5 d5 b4 a4 g4").slow(4).fm(0.48)],
    [4, note("e5 d5 b4 a4 g4 e4 g4 a4 b4 d5 e5 d5 b4 a4 g4 e4").slow(4).fm(0.72)]
  ).s("sine").fmh(1.414).fmdecay(0.24).fmsustain(0.12)
    .gain(0.2).attack(0.008).decay(0.18).sustain(0.15).release(0.2).lpf(4800),
  note("e3 b3 e3 b3").slow(4).s("sine").gain(0.08).release(0.18)
)
