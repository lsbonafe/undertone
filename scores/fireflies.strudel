// Additive synthesis: the same pitch gains more harmonic components through the story.
// A major pentatonic; the partials combine into one waveform rather than separate melodies.
stack(
  arrange(
    [4, note("a3 cs4 e4 fs4 e4 cs4 b3 cs4 e4 fs4 a4 fs4 e4 cs4 b3 a3").slow(4).partials([1])],
    [4, note("cs4 e4 fs4 a4 b4 cs5 b4 a4 fs4 e4 cs4 e4 fs4 a4 e4 cs4").slow(4).partials([1, 0.28, 0.16])],
    [4, note("a4 cs5 e5 cs5 b4 a4 fs4 e4 cs4 e4 fs4 a4 fs4 e4 cs4 a4").slow(4).partials([1, 0.28, 0.16, 0.1, 0.06, 0.04])]
  ).s("user").gain(0.22).attack(0.025).decay(0.1).sustain(0.3).release(0.15).lpf(4200),
  note("a2 e3 a2 e3").slow(4).s("sine").gain(0.08).release(0.15)
)
