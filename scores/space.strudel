// Undertone 01 — Wonder. Original composition, D Lydian.
// A D–A pedal and a shared mode hold the phrases together in either direction.
stack(
  arrange(
    [4, note("d4 a4 e5 fs5 a4 e5 fs5 gs5 a5 fs5 e5 a4 b4 a4 e5 d5").slow(4)],
    [4, note("a4 e5 fs5 gs5 a5 cs6 b5 a5 gs5 fs5 e5 fs5 a5 b5 a5 e5").slow(4)],
    [4, note("d5 a5 b5 cs6 a5 gs5 fs5 e5 a5 fs5 e5 d5 fs5 e5 a4 d5").slow(4)]
  ).s("sine").gain(0.28).attack(0.012).decay(0.12).sustain(0.3).release(0.16).lpf(5200),
  note("d3 a3 d3 a3").slow(4).s("triangle").gain(0.12).attack(0.025).release(0.14).lpf(1800)
)
