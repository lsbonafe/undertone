// An original C4 strike becomes fragments, then larger pieces. Seeded omissions retrace exactly.
stack(
  arrange(
    [4, note("c4 e4 g4 a4 g4 e4 d4 c4").slow(4).chop(16).speed(-1).degradeBy(0.18).seed(17)],
    [4, note("e4 g4 a4 c5 a4 g4 e4 d4").slow(4).chop(8).degradeBy(0.08).seed(17)],
    [4, note("c4 d4 e4 g4 a4 g4 e4 c4").slow(4).chop(4)]
  ).s("porcelain").gain(0.23).pan(sine.range(0.25,0.75).slow(4))
    .attack(0.008).decay(0.1).sustain(0.3).release(0.18)
    .hpf(120).delay(0.1).delaytime(0.2).delayfeedback(0.12).orbit(2),
  note("c3 g3 c3 g3").slow(4).s("sine").gain(0.08).release(0.22)
)
