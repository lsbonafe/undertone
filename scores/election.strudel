// C Mixolydian. Suspensions gather urgency, then a recurring motif favors C–E–G.
// An integer FM ratio keeps the added overtones harmonically related.
stack(
  arrange(
    [4, note("c4 f4 g4 f4 d4 c4 d4 f4 g4 a4 g4 f4 d4 f4 d4 c4").slow(4).fm(0.18)],
    [4, note("c4 d4 f4 g4 bb4 a4 g4 f4 d4 f4 g4 bb4 a4 g4 f4 d4").slow(4).fm(0.5)],
    [4, note("c4 e4 g4 a4 g4 e4 d4 c4 e4 g4 a4 g4 e4 d4 g4 c4").slow(4).fm(0.24)]
  ).s("sine").fmh(2).fmdecay(0.18).fmsustain(0.18)
    .gain(0.2).attack(0.025).decay(0.16).sustain(0.25).release(0.2).lpf(3800),
  note("c3 g3 c3 g3").slow(4).s("sine").gain(0.07).release(0.2)
)
