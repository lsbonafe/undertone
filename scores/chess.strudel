// Three pulses against five in eight slots: two players, two sides of the stereo field.
stack(
  arrange(
    [4, note("d4(3,8)")],
    [4, note("f4(3,8)")],
    [4, note("e4(3,8)")]
  ).s("square").gain(0.17).pan(0.18).lpf(1900).lpq(0.8)
    .penv(0.4).pattack(0.03).pdecay(0.09).psustain(0).prelease(0.1)
    .bpf(1800).bpq(0.7).attack(0.01).decay(0.1).sustain(0.12).release(0.16).delay(0).orbit(2),
  arrange(
    [4, note("a4(5,8,1)")],
    [4, note("c5(5,8,1)")],
    [4, note("a4(5,8,1)")]
  ).s("triangle").gain(0.15).pan(0.82).lpf(2400)
    .attack(0.015).decay(0.1).sustain(0.12).release(0.16).delay(0).orbit(3),
  note("d3 a3 d3 a3").slow(4).s("sine").gain(0.07).release(0.2)
)
