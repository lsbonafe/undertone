// ZZFX: a deliberately tiny, slightly crooked arcade tune.
stack(
  arrange(
    [4, note("c4 e4 g4 a4 g4 e4 d4 c4 e4 g4 a4 g4 e4 d4 g4 c4").slow(4).slide(0)],
    [4, note("c4 g4 a4 g4 e4 d4 e4 g4 a4 c5 a4 g4 e4 g4 d4 c4").slow(4).slide(0.015)],
    [4, note("g4 e4 c4 d4 e4 g4 a4 g4 e4 d4 c4 e4 g4 e4 d4 c4").slow(4).slide(-0.01)]
  ).s("z_square").zrand(0).zcrush(0.1).curve(1.2).gain(0.23)
    .attack(0.01).decay(0.08).sustain(0.2).release(0.12).lpf(2400).delay(0).orbit(2),
  note("c3 g3 c3 g3").slow(4).s("sine").gain(0.07).release(0.2)
)
