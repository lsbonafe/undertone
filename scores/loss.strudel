// A small E-minor phrase changes its envelope and contracts in register.
stack(
  arrange(
    [4, note("e4 g4 b4 a4 g4 fs4 e4 d4 e4 g4 a4 g4 fs4 e4 d4 e4").slow(4).attack(0.06)],
    [4, note("e4 fs4 g4 b4 c5 b4 a4 g4 fs4 g4 a4 g4 fs4 e4 d4 e4").slow(4).attack(0.1)],
    [4, note("e4 g4 fs4 e4 d4 e4 g4 fs4 e4 d4 b3 d4 e4 fs4 d4 e4").slow(4).attack(0.14)]
  ).s("triangle").gain(0.19).decay(0.2).sustain(0.32).release(0.28).lpf(1800),
  note("e3 b3 e3 b3").slow(4).s("sine").gain(0.07).release(0.24)
)
